# Copie este arquivo pra .env.production.local (NÃO commite!)
# Depois configure cada variável no Vercel dashboard também

# Supabase (sa-east-1 após migração)
NEXT_PUBLIC_SUPABASE_URL=https://[seu-projeto-sa].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:[senha]@[host]:6543/postgres?schema=public
DATABASE_URL_DIRECT=postgresql://postgres:[senha]@[host]:5432/postgres?schema=public

# Site público
NEXT_PUBLIC_SITE_URL=https://oab.app.br

# Mercado Pago (PRODUÇÃO — APP_USR prefix)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=...

# Resend (e-mail)
RESEND_API_KEY=re_...
RESEND_FROM=noreply@oab.app.br

# Google OAuth (se usar)
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...

# Vercel (opcional, gerado automaticamente)
VERCEL_TOKEN=...
