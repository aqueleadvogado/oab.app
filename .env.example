# ─────────────────────────────────────────────
# Copie este arquivo para .env.local e preencha.
# .env.local NUNCA vai para o git (já está no .gitignore).
# ─────────────────────────────────────────────

# Supabase (Settings → API)
# A URL e a anon key são públicas (vão para o cliente). A service_role é SECRETA.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...publicadanocliente..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...SECRETA..."

# Postgres (Settings → Database → Connection string)
# Use a "Transaction" connection string (pooler, porta 6543) para o app rodar.
# Para migrations (drizzle-kit) use a "Session" string (porta 5432, direct).
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
DATABASE_URL_DIRECT="postgresql://postgres.xxxxxxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Resend (vamos usar na Fase 1.7, pode deixar em branco por ora)
RESEND_API_KEY=""
RESEND_FROM="OAB em Blocos <contato@oab.app.br>"
